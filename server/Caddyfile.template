${SITES} {
  encode gzip zstd

  rate_limit {
    zone analytics_ip {
      key {remote_host}
      events {$CADDY_RATE_LIMIT_EVENTS}
      window {$CADDY_RATE_LIMIT_WINDOW}
      match {
        path /collect /batch
        method POST
      }
    }
  }

  @analytics path /openapi.json /collect /batch /healthz /readyz

  handle @analytics {
    reverse_proxy ${UPSTREAM}
  }
}
