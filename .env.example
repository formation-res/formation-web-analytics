ALLOWED_DOMAINS=analytics.tryformation.com,tryformation.com
SITE_ORIGIN_MAP=
CADDY_DOMAINS=analytics.tryformation.com
CADDY_RATE_LIMIT_EVENTS=120
CADDY_RATE_LIMIT_WINDOW=1m
ELASTICSEARCH_URL=https://elasticsearch:9200
ELASTICSEARCH_API_KEY=changeme
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_DATA_STREAM=analytics-events
MAXMIND_ACCOUNT_ID=your-account-id
MAXMIND_LICENSE_KEY=your-license-key
GEOIPUPDATE_EDITION_IDS=GeoLite2-City
GEOIPUPDATE_FREQUENCY=24
GEOIPUPDATE_VERBOSE=0
GEOIP_DB_PATH=/data/GeoLite2-City.mmdb
GEOIP_WAIT_TIMEOUT=300
LISTEN_ADDR=:8080
METRICS_ENABLED=false
METRICS_LISTEN_ADDR=:9090
FLUSH_INTERVAL=5s
MAX_BATCH_SIZE=500
MAX_QUEUE_SIZE=10000
MAX_PAYLOAD_BYTES=1048576
MAX_EVENTS_PER_REQUEST=100
MAX_FIELD_LENGTH=10240
MAX_PAYLOAD_ENTRIES=128
MAX_PAYLOAD_DEPTH=4
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_MAX_CLIENTS=100000
MAX_RETRIES=10
RETRY_MIN_BACKOFF=1s
RETRY_MAX_BACKOFF=60s
TRUST_PROXY_HEADERS=true
CAPTURE_CLIENT_IP=false
STORE_IP_METADATA=false
SANITIZE_URLS=true
REQUIRE_ORIGIN=true
REQUIRE_URL_HOST_MATCH=true
REQUIRE_ELASTIC_READY=false
BLOCKED_USER_AGENTS=bot,crawler,spider,curl,wget,python-requests,python-urllib,go-http-client
SUSPECT_USER_AGENTS=headless,playwright,puppeteer,selenium,phantomjs
DROP_POLICY=reject
LOG_LEVEL=info
RETENTION_DAYS=90
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
